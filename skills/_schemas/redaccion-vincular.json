{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Entrada del redactor vincular",
  "description": "Valida forma; las referencias cruzadas, compatibilidad de fuentes y fecha se verifican adicionalmente con redactor.py. No valida la verdad ni la procedencia jurídica.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "titulo",
    "fecha_corte",
    "fuentes",
    "hechos",
    "criterios",
    "bloques"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "titulo": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "fecha_corte": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "format": "date"
    },
    "fuentes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "tipo",
          "titulo",
          "ubicacion",
          "limite"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,32}$"
          },
          "tipo": {
            "enum": [
              "original",
              "reproduccion",
              "transcripcion",
              "relato",
              "analisis"
            ]
          },
          "titulo": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "ubicacion": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "limite": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "url": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^https://[^\\s<>\\\"]+$"
              },
              {
                "const": ""
              }
            ]
          }
        }
      }
    },
    "hechos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "estado",
          "contenido",
          "fuentes",
          "limite"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,32}$"
          },
          "estado": {
            "enum": [
              "documento",
              "relato",
              "hipotesis",
              "pendiente"
            ]
          },
          "contenido": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "fuentes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,32}$"
            }
          },
          "limite": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "estado": {
                  "enum": [
                    "documento",
                    "relato",
                    "hipotesis"
                  ]
                }
              },
              "required": [
                "estado"
              ]
            },
            "then": {
              "properties": {
                "fuentes": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    "criterios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "cita",
          "url",
          "uso",
          "limite"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,32}$"
          },
          "cita": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "url": {
            "type": "string",
            "pattern": "^https://[^\\s<>\\\"]+$"
          },
          "uso": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "limite": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          }
        }
      }
    },
    "bloques": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "via",
          "pregunta",
          "argumento",
          "hechos",
          "criterios",
          "peticiones",
          "verificaciones"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,32}$"
          },
          "via": {
            "enum": [
              "familiar",
              "amparo",
              "penal",
              "peticion-cidh",
              "cautelares-cidh"
            ]
          },
          "pregunta": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "argumento": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "hechos": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,32}$"
            }
          },
          "criterios": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,32}$"
            }
          },
          "peticiones": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": ".*\\S.*"
            }
          },
          "verificaciones": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": ".*\\S.*"
            }
          }
        }
      }
    }
  }
}
